{
  "name": "backhaus-ai-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Strands Agents worker for the Backhaus AI backend. Spawned and supervised by the Rust runtime.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@strands-agents/sdk": "1.17.0",
    "openai": "6.49.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
