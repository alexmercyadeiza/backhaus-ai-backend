DATABASE_URL=postgres://apple@127.0.0.1/backhaus_ai_dev
# Local API is fixed at 127.0.0.1:8090.
# Required for every /v1 endpoint. Set a long random value; never VITE_*.
BACKEND_API_KEY=replace-with-a-random-secret
# Shared tester sign-in; set both in the private .env before using the dashboard.
# DEMO_EMAIL=alex@backhaus.ai
# DEMO_PASSWORD=your-tester-password
# Local dashboard origin is fixed at http://127.0.0.1:5173.
# Explicitly opt into one business workspace. Requests cannot override this.
WORKSPACE_ID=org_default
DB_MAX_CONNECTIONS=4
# Set both before enabling model-powered chat. No implicit cloud fallback.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=deepseek/deepseek-v4.1-flash
# Add your OpenRouter key only in the private .env.
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=120
WORKER_POLL_SECONDS=2
TYPST_BIN=typst
# Strands worker (Node.js 24+). Build it once: cd worker && npm ci && npm run build
NODE_BIN=node
WORKER_SCRIPT=worker/dist/worker.js
RUST_LOG=backhaus_ai_backend=info,tower_http=info
# MODEL_BASE_URL is your inference API base including /v1, not /chat/completions.
# MODEL_NAME must match the ID/alias served by that host. MODEL_API_KEY is server-only.
# Validate/save with scripts/configure-model.py --url ... --model ... --prompt-key --save

# OpenRouter: concise answers, prioritize latency, cap per-million-token provider prices.
MODEL_REQUEST_OPTIONS='{"reasoning":{"effort":"none"},"provider":{"sort":"latency","require_parameters":true,"max_price":{"prompt":0.30,"completion":1.20}}}'

# Optional supplier enquiries. Never expose these through VITE_* or worker env.
RESEND_API_KEY=
RESEND_FROM=
