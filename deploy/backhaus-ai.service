[Unit]
Description=Backhaus AI API, monitors and Strands worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backhaus-ai
Group=backhaus-ai
WorkingDirectory=/opt/backhaus-ai-backend
EnvironmentFile=/etc/backhaus-ai/backend.env
ExecStart=/opt/backhaus-ai-backend/backhaus-ai-backend start
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryHigh=256M
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
